# Virtual environment (recreate with: pip install -r requirements.txt)
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo

# FastF1 cache (regenerated automatically by prepare_data.py)
data/cache/

# Generated data is committed on purpose, so the agent can be trained and
# evaluated without FastF1 network calls. To stop tracking it, uncomment:
# data/*.npy
# data/*.csv

# Jupyter checkpoints
.ipynb_checkpoints/

# OS/editor
.DS_Store
.vscode/
*.swp

# pytest
.pytest_cache/
